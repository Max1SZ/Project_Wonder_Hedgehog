(2)   15/   7542E :                     
(2)   16/   7542E : =$1                  SMPS2ASMVer	= 1
(2)   17/   7542E :                     
(2)   18/   7542E :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   7542E : =$C                  psgdelta	EQU 12
(2)   20/   7542E :                     ; ---------------------------------------------------------------------------
(2)   21/   7542E :                     ; Standard Octave Pitch Equates
(2)   22/   7542E :                     	enumconf	$C
(2)   23/   7542E : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   7542E : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   7542E : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   7542E : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   7542E : =$78                 	nextenum	smpsPitch10hi
(2)   28/   7542E :                     	enumconf	1
(2)   29/   7542E :                     ; ---------------------------------------------------------------------------
(2)   30/   7542E :                     ; Note Equates
(2)   31/   7542E : =$80                 	enum		nRst=$80
(2)   32/   7542E : =$81..$86            	nextenum	nC0,nCs0,nDb0=nCs0,nD0,nDs0,nEb0=nDs0,nE0,nFb0=nE0,nEs0,nF0=nEs0
(2)   33/   7542E : =$87..$8D            	nextenum	nFs0,nGb0=nFs0,nG0,nGs0,nAb0=nGs0,nA0,nAs0,nBb0=nAs0,nB0,nCb1=nB0,nBs0
(2)   34/   7542E : =$8D..$92            	nextenum	nC1=nBs0,nCs1,nDb1=nCs1,nD1,nDs1,nEb1=nDs1,nE1,nFb1=nE1,nEs1,nF1=nEs1
(2)   35/   7542E : =$93..$99            	nextenum	nFs1,nGb1=nFs1,nG1,nGs1,nAb1=nGs1,nA1,nAs1,nBb1=nAs1,nB1,nCb2=nB1,nBs1
(2)   36/   7542E : =$99..$9E            	nextenum	nC2=nBs1,nCs2,nDb2=nCs2,nD2,nDs2,nEb2=nDs2,nE2,nFb2=nE2,nEs2,nF2=nEs2
(2)   37/   7542E : =$9F..$A5            	nextenum	nFs2,nGb2=nFs2,nG2,nGs2,nAb2=nGs2,nA2,nAs2,nBb2=nAs2,nB2,nCb3=nB2,nBs2
(2)   38/   7542E : =$A5..$AA            	nextenum	nC3=nBs2,nCs3,nDb3=nCs3,nD3,nDs3,nEb3=nDs3,nE3,nFb3=nE3,nEs3,nF3=nEs3
(2)   39/   7542E : =$AB..$B1            	nextenum	nFs3,nGb3=nFs3,nG3,nGs3,nAb3=nGs3,nA3,nAs3,nBb3=nAs3,nB3,nCb4=nB3,nBs3
(2)   40/   7542E : =$B1..$B6            	nextenum	nC4=nBs3,nCs4,nDb4=nCs4,nD4,nDs4,nEb4=nDs4,nE4,nFb4=nE4,nEs4,nF4=nEs4
(2)   41/   7542E : =$B7..$BD            	nextenum	nFs4,nGb4=nFs4,nG4,nGs4,nAb4=nGs4,nA4,nAs4,nBb4=nAs4,nB4,nCb5=nB4,nBs4
(2)   42/   7542E : =$BD..$C2            	nextenum	nC5=nBs4,nCs5,nDb5=nCs5,nD5,nDs5,nEb5=nDs5,nE5,nFb5=nE5,nEs5,nF5=nEs5
(2)   43/   7542E : =$C3..$C9            	nextenum	nFs5,nGb5=nFs5,nG5,nGs5,nAb5=nGs5,nA5,nAs5,nBb5=nAs5,nB5,nCb6=nB5,nBs5
(2)   44/   7542E : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   7542E : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   7542E : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   7542E : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   7542E :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   7542E :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   7542E :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   7542E :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   7542E : =$C6                 nMaxPSG				EQU nA5
(2)   54/   7542E : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   7542E : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   7542E :                     ; ---------------------------------------------------------------------------
(2)   62/   7542E :                     ; PSG volume envelope equates
(2)   65/   7542E : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   7542E : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   7542E :                     ; ---------------------------------------------------------------------------
(2)   87/   7542E :                     ; DAC Equates
(2)   90/   7542E : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   7542E : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   7542E :                     ; ---------------------------------------------------------------------------
(2)  170/   7542E :                     ; Channel IDs for SFX
(2)  171/   7542E : =$80                 cPSG1				EQU $80
(2)  172/   7542E : =$A0                 cPSG2				EQU $A0
(2)  173/   7542E : =$C0                 cPSG3				EQU $C0
(2)  174/   7542E : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   7542E : =$2                  cFM3				EQU $02
(2)  176/   7542E : =$4                  cFM4				EQU $04
(2)  177/   7542E : =$5                  cFM5				EQU $05
(2)  178/   7542E : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   7542E :                     ; ---------------------------------------------------------------------------
(2)  180/   7542E :                     ; Conversion macros and functions
(2)  181/   7542E :                     
(2)  182/   7542E :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   7542E :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   7542E :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   7542E :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   7542E :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   7542E :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   7542E :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   7542E :                     
(2)  190/   7542E :                     convertMainTempoMod macro mod
(2)  191/   7542E :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   7542E :                     		dc.b	mod
(2)  193/   7542E :                     	elseif SourceDriver==1
(2)  194/   7542E :                     		if mod==1
(2)  195/   7542E :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   7542E :                     		endif
(2)  197/   7542E :                     		if SonicDriverVer==2
(2)  198/   7542E :                     			dc.b	s1TempotoS2(mod)
(2)  199/   7542E :                     		else;if SonicDriverVer>=3
(2)  200/   7542E :                     			dc.b	s1TempotoS3(mod)
(2)  201/   7542E :                     		endif
(2)  202/   7542E :                     	elseif SourceDriver==2
(2)  203/   7542E :                     		if mod==0
(2)  204/   7542E :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   7542E :                     		endif
(2)  206/   7542E :                     		if SonicDriverVer==1
(2)  207/   7542E :                     			dc.b	s2TempotoS1(mod)
(2)  208/   7542E :                     		else;if SonicDriverVer>=3
(2)  209/   7542E :                     			dc.b	s2TempotoS3(mod)
(2)  210/   7542E :                     		endif
(2)  211/   7542E :                     	else;if SourceDriver>=3
(2)  212/   7542E :                     		if mod==0
(2)  213/   7542E :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   7542E :                     		endif
(2)  215/   7542E :                     		if SonicDriverVer==1
(2)  216/   7542E :                     			dc.b	s3TempotoS1(mod)
(2)  217/   7542E :                     		else;if SonicDriverVer==2
(2)  218/   7542E :                     			dc.b	s3TempotoS2(mod)
(2)  219/   7542E :                     		endif
(2)  220/   7542E :                     	endif
(2)  221/   7542E :                     	endm
(2)  222/   7542E :                     
(2)  223/   7542E :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   7542E :                     PSGPitchConvert macro pitch
(2)  225/   7542E :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   7542E :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   7542E :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   7542E :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   7542E :                     	else
(2)  230/   7542E :                     		dc.b	pitch
(2)  231/   7542E :                     	endif
(2)  232/   7542E :                     	endm
(2)  233/   7542E :                     
(2)  234/   7542E :                     CheckedChannelPointer macro loc
(2)  235/   7542E :                     	if SonicDriverVer<>1
(2)  236/   7542E :                     		dc.w	z80_ptr(loc)
(2)  237/   7542E :                     	else
(2)  238/   7542E :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   7542E :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   7542E :                     		endif
(2)  241/   7542E :                     		dc.w	loc-songStart
(2)  242/   7542E :                     	endif
(2)  243/   7542E :                     	endm
(2)  244/   7542E :                     ; ---------------------------------------------------------------------------
(2)  245/   7542E :                     ; Header Macros
(2)  246/   7542E :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   7542E :                     
(2)  248/   7542E :                     SourceDriver set ver
(2)  249/   7542E :                     
(2)  250/   7542E :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   7542E :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   7542E :                     	else
(2)  253/   7542E :                     		set SourceSMPS2ASM,0
(2)  254/   7542E :                     	endif
(2)  255/   7542E :                     
(2)  256/   7542E :                     songStart set *
(2)  257/   7542E :                     
(2)  258/   7542E :                     	if MOMPASS=1
(2)  259/   7542E :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   7542E :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   7542E :                     		endif
(2)  262/   7542E :                     	endif
(2)  263/   7542E :                     
(2)  264/   7542E :                     	endm
(2)  265/   7542E :                     
(2)  266/   7542E :                     smpsHeaderVoiceNull macro
(2)  267/   7542E :                     	if songStart<>*
(2)  268/   7542E :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   7542E :                     	endif
(2)  270/   7542E :                     	dc.w	$0000
(2)  271/   7542E :                     	endm
(2)  272/   7542E :                     
(2)  273/   7542E :                     ; Header - Set up Voice Location
(2)  274/   7542E :                     ; Common to music and SFX
(2)  275/   7542E :                     smpsHeaderVoice macro loc
(2)  276/   7542E :                     	if songStart<>*
(2)  277/   7542E :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   7542E :                     	endif
(2)  279/   7542E :                     	if SonicDriverVer<>1
(2)  280/   7542E :                     		dc.w	z80_ptr(loc)
(2)  281/   7542E :                     	else
(2)  282/   7542E :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   7542E :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   7542E :                     		endif
(2)  285/   7542E :                     		dc.w	loc-songStart
(2)  286/   7542E :                     	endif
(2)  287/   7542E :                     	endm
(2)  288/   7542E :                     
(2)  289/   7542E :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   7542E :                     ; Common to music and SFX
(2)  291/   7542E :                     smpsHeaderVoiceUVB macro
(2)  292/   7542E :                     	if songStart<>*
(2)  293/   7542E :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   7542E :                     	endif
(2)  295/   7542E :                     	if SonicDriverVer>=5
(2)  296/   7542E :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   7542E :                     	elseif SonicDriverVer>=3
(2)  298/   7542E :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   7542E :                     	else
(2)  300/   7542E :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   7542E :                     	endif
(2)  302/   7542E :                     	endm
(2)  303/   7542E :                     
(2)  304/   7542E :                     ; Header macros for music (not for SFX)
(2)  305/   7542E :                     ; Header - Set up Channel Usage
(2)  306/   7542E :                     smpsHeaderChan macro fm,psg
(2)  307/   7542E :                     	dc.b	fm,psg
(2)  308/   7542E :                     	endm
(2)  309/   7542E :                     
(2)  310/   7542E :                     ; Header - Set up Tempo
(2)  311/   7542E :                     smpsHeaderTempo macro div,mod
(2)  312/   7542E :                     	dc.b	div
(2)  313/   7542E :                     	convertMainTempoMod mod
(2)  314/   7542E :                     	endm
(2)  315/   7542E :                     
(2)  316/   7542E :                     ; Header - Set up DAC Channel
(2)  317/   7542E :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   7542E :                     	CheckedChannelPointer loc
(2)  319/   7542E :                     	if ("pitch"<>"")
(2)  320/   7542E :                     		dc.b	pitch
(2)  321/   7542E :                     		if ("vol"<>"")
(2)  322/   7542E :                     			dc.b	vol
(2)  323/   7542E :                     		else
(2)  324/   7542E :                     			dc.b	$00
(2)  325/   7542E :                     		endif
(2)  326/   7542E :                     	else
(2)  327/   7542E :                     		dc.w	$00
(2)  328/   7542E :                     	endif
(2)  329/   7542E :                     	endm
(2)  330/   7542E :                     
(2)  331/   7542E :                     ; Header - Set up FM Channel
(2)  332/   7542E :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   7542E :                     	CheckedChannelPointer loc
(2)  334/   7542E :                     	dc.b	pitch,vol
(2)  335/   7542E :                     	endm
(2)  336/   7542E :                     
(2)  337/   7542E :                     ; Header - Set up PSG Channel
(2)  338/   7542E :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   7542E :                     	CheckedChannelPointer loc
(2)  340/   7542E :                     	PSGPitchConvert pitch
(2)  341/   7542E :                     	dc.b	vol
(2)  342/   7542E :                     	; Frequency envelope
(2)  343/   7542E :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   7542E :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   7542E :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   7542E :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   7542E :                     		dc.b	0
(2)  348/   7542E :                     	else
(2)  349/   7542E :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   7542E :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  351/   7542E :                     		endif
(2)  352/   7542E :                     		dc.b	mod
(2)  353/   7542E :                     	endif
(2)  354/   7542E :                     	; Volume envelope
(2)  355/   7542E :                     	dc.b	voice
(2)  356/   7542E :                     	endm
(2)  357/   7542E :                     
(2)  358/   7542E :                     ; Header macros for SFX (not for music)
(2)  359/   7542E :                     ; Header - Set up Tempo
(2)  360/   7542E :                     smpsHeaderTempoSFX macro div
(2)  361/   7542E :                     	dc.b	div
(2)  362/   7542E :                     	endm
(2)  363/   7542E :                     
(2)  364/   7542E :                     ; Header - Set up Channel Usage
(2)  365/   7542E :                     smpsHeaderChanSFX macro chan
(2)  366/   7542E :                     	dc.b	chan
(2)  367/   7542E :                     	endm
(2)  368/   7542E :                     
(2)  369/   7542E :                     ; Header - Set up FM Channel
(2)  370/   7542E :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   7542E :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   7542E :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   7542E :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   7542E :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   7542E :                     	endif
(2)  376/   7542E :                     	dc.b	$80,chanid
(2)  377/   7542E :                     	CheckedChannelPointer loc
(2)  378/   7542E :                     	if (chanid&$80)<>0
(2)  379/   7542E :                     		PSGPitchConvert pitch
(2)  380/   7542E :                     	else
(2)  381/   7542E :                     		dc.b	pitch
(2)  382/   7542E :                     	endif
(2)  383/   7542E :                     	dc.b	vol
(2)  384/   7542E :                     	endm
(2)  385/   7542E :                     ; ---------------------------------------------------------------------------
(2)  386/   7542E :                     ; Co-ord Flag Macros and Equates
(2)  387/   7542E :                     ; E0xx - Panning, AMS, FMS
(2)  388/   7542E :                     smpsPan macro direction,amsfms
(2)  389/   7542E :                     panNone set $00
(2)  390/   7542E :                     panRight set $40
(2)  391/   7542E :                     panLeft set $80
(2)  392/   7542E :                     panCentre set $C0
(2)  393/   7542E :                     panCenter set $C0 ; silly Americans :U
(2)  394/   7542E :                     	dc.b $E0,direction+amsfms
(2)  395/   7542E :                     	endm
(2)  396/   7542E :                     
(2)  397/   7542E :                     ; E1xx - Set channel detune to val
(2)  398/   7542E :                     smpsDetune macro val
(2)  399/   7542E :                     	dc.b	$E1,val
(2)  400/   7542E :                     	endm
(2)  401/   7542E :                     
(2)  402/   7542E :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   7542E :                     smpsNop macro val
(2)  404/   7542E :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   7542E :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   7542E :                     	endif
(2)  407/   7542E :                     	dc.b	$E2,val
(2)  408/   7542E :                     	endm
(2)  409/   7542E :                     
(2)  410/   7542E :                     ; Return (used after smpsCall)
(2)  411/   7542E :                     smpsReturn macro val
(2)  412/   7542E :                     	if SonicDriverVer>=3
(2)  413/   7542E :                     		dc.b	$F9
(2)  414/   7542E :                     	else
(2)  415/   7542E :                     		dc.b	$E3
(2)  416/   7542E :                     	endif
(2)  417/   7542E :                     	endm
(2)  418/   7542E :                     
(2)  419/   7542E :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   7542E :                     smpsFade macro val
(2)  421/   7542E :                     	if SonicDriverVer>=3
(2)  422/   7542E :                     		dc.b	$E2
(2)  423/   7542E :                     		if ("val"<>"")
(2)  424/   7542E :                     			dc.b	val
(2)  425/   7542E :                     		else
(2)  426/   7542E :                     			dc.b	$FF
(2)  427/   7542E :                     		endif
(2)  428/   7542E :                     		if SourceDriver<3
(2)  429/   7542E :                     			smpsStop
(2)  430/   7542E :                     		endif
(2)  431/   7542E :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   7542E :                     		; This is actually a communication byte, not a fade.
(2)  433/   7542E :                     		smpsNop	val
(2)  434/   7542E :                     	else
(2)  435/   7542E :                     		dc.b	$E4
(2)  436/   7542E :                     	endif
(2)  437/   7542E :                     	endm
(2)  438/   7542E :                     
(2)  439/   7542E :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   7542E :                     smpsChanTempoDiv macro val
(2)  441/   7542E :                     	if SonicDriverVer>=5
(2)  442/   7542E :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   7542E :                     		dc.b	$FF,$08,val
(2)  444/   7542E :                     	elseif SonicDriverVer==3
(2)  445/   7542E :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   7542E :                     	else
(2)  447/   7542E :                     		dc.b	$E5,val
(2)  448/   7542E :                     	endif
(2)  449/   7542E :                     	endm
(2)  450/   7542E :                     
(2)  451/   7542E :                     ; E6xx - Alter Volume by xx
(2)  452/   7542E :                     smpsAlterVol macro val
(2)  453/   7542E :                     	dc.b	$E6,val
(2)  454/   7542E :                     	endm
(2)  455/   7542E :                     
(2)  456/   7542E :                     ; E7 - Prevent attack of next note
(2)  457/   7542E : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   7542E :                     
(2)  459/   7542E :                     ; E8xx - Set note fill to xx
(2)  460/   7542E :                     smpsNoteFill macro val
(2)  461/   7542E :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   7542E :                     		; Unique to Flamewing's modified driver
(2)  463/   7542E :                     		dc.b	$FF,$0A,val
(2)  464/   7542E :                     	else
(2)  465/   7542E :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   7542E :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   7542E :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   7542E :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   7542E :                     		endif
(2)  470/   7542E :                     		dc.b	$E8,val
(2)  471/   7542E :                     	endif
(2)  472/   7542E :                     	endm
(2)  473/   7542E :                     
(2)  474/   7542E :                     ; Add xx to channel pitch
(2)  475/   7542E :                     smpsChangeTransposition macro val
(2)  476/   7542E :                     	if SonicDriverVer>=3
(2)  477/   7542E :                     		dc.b	$FB,val
(2)  478/   7542E :                     	else
(2)  479/   7542E :                     		dc.b	$E9,val
(2)  480/   7542E :                     	endif
(2)  481/   7542E :                     	endm
(2)  482/   7542E :                     
(2)  483/   7542E :                     ; Set music tempo modifier to xx
(2)  484/   7542E :                     smpsSetTempoMod macro mod
(2)  485/   7542E :                     	if SonicDriverVer>=3
(2)  486/   7542E :                     		dc.b	$FF,$00
(2)  487/   7542E :                     	else
(2)  488/   7542E :                     		dc.b	$EA
(2)  489/   7542E :                     	endif
(2)  490/   7542E :                     	convertMainTempoMod mod
(2)  491/   7542E :                     	endm
(2)  492/   7542E :                     
(2)  493/   7542E :                     ; Set music tempo divider to xx
(2)  494/   7542E :                     smpsSetTempoDiv macro val
(2)  495/   7542E :                     	if SonicDriverVer>=3
(2)  496/   7542E :                     		dc.b	$FF,$04,val
(2)  497/   7542E :                     	else
(2)  498/   7542E :                     		dc.b	$EB,val
(2)  499/   7542E :                     	endif
(2)  500/   7542E :                     	endm
(2)  501/   7542E :                     
(2)  502/   7542E :                     ; ECxx - Set Volume to xx
(2)  503/   7542E :                     smpsSetVol macro val
(2)  504/   7542E :                     	if SonicDriverVer>=3
(2)  505/   7542E :                     		dc.b	$E4,val
(2)  506/   7542E :                     	else
(2)  507/   7542E :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   7542E :                     	endif
(2)  509/   7542E :                     	endm
(2)  510/   7542E :                     
(2)  511/   7542E :                     ; Works on all drivers
(2)  512/   7542E :                     smpsPSGAlterVol macro vol
(2)  513/   7542E :                     	dc.b	$EC,vol
(2)  514/   7542E :                     	endm
(2)  515/   7542E :                     
(2)  516/   7542E :                     smpsPSGAlterVolS2 macro vol
(2)  517/   7542E :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   7542E :                     	if SonicDriverVer==2
(2)  519/   7542E :                     		smpsAlterVol vol
(2)  520/   7542E :                     	else
(2)  521/   7542E :                     		smpsPSGAlterVol vol
(2)  522/   7542E :                     	endif
(2)  523/   7542E :                     	endm
(2)  524/   7542E :                     
(2)  525/   7542E :                     ; Clears pushing sound flag in S1
(2)  526/   7542E :                     smpsClearPush macro
(2)  527/   7542E :                     	if SonicDriverVer==1
(2)  528/   7542E :                     		dc.b	$ED
(2)  529/   7542E :                     	else
(2)  530/   7542E :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   7542E :                     	endif
(2)  532/   7542E :                     	endm
(2)  533/   7542E :                     
(2)  534/   7542E :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   7542E :                     smpsStopSpecial macro
(2)  536/   7542E :                     	if SonicDriverVer==1
(2)  537/   7542E :                     		dc.b	$EE
(2)  538/   7542E :                     	else
(2)  539/   7542E :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   7542E :                     		smpsStop
(2)  541/   7542E :                     	endif
(2)  542/   7542E :                     	endm
(2)  543/   7542E :                     
(2)  544/   7542E :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   7542E :                     smpsFMvoice macro voice,songID
(2)  546/   7542E :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   7542E :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   7542E :                     	else
(2)  549/   7542E :                     		dc.b	$EF,voice
(2)  550/   7542E :                     	endif
(2)  551/   7542E :                     	endm
(2)  552/   7542E :                     
(2)  553/   7542E :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   7542E :                     smpsModSet macro wait,speed,change,step
(2)  555/   7542E :                     	dc.b	$F0
(2)  556/   7542E :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   7542E :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   7542E :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   7542E :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   7542E :                     	else
(2)  561/   7542E :                     		dc.b	wait,speed,change,step
(2)  562/   7542E :                     	endif
(2)  563/   7542E :                     	;dc.b	speed,change,step
(2)  564/   7542E :                     	endm
(2)  565/   7542E :                     
(2)  566/   7542E :                     ; Turn on Modulation
(2)  567/   7542E :                     smpsModOn macro type
(2)  568/   7542E :                     	if SonicDriverVer>=3
(2)  569/   7542E :                     		if "type"<>""
(2)  570/   7542E :                     			dc.b	$F4,type
(2)  571/   7542E :                     		else
(2)  572/   7542E :                     			dc.b	$F4,$80
(2)  573/   7542E :                     		endif
(2)  574/   7542E :                     	else
(2)  575/   7542E :                     		dc.b	$F1
(2)  576/   7542E :                     	endif
(2)  577/   7542E :                     	endm
(2)  578/   7542E :                     
(2)  579/   7542E :                     ; F2 - End of channel
(2)  580/   7542E :                     smpsStop macro
(2)  581/   7542E :                     	dc.b	$F2
(2)  582/   7542E :                     	endm
(2)  583/   7542E :                     
(2)  584/   7542E :                     ; F3xx - PSG waveform to xx
(2)  585/   7542E :                     smpsPSGform macro form
(2)  586/   7542E :                     	dc.b	$F3,form
(2)  587/   7542E :                     	endm
(2)  588/   7542E :                     
(2)  589/   7542E :                     ; Turn off Modulation
(2)  590/   7542E :                     smpsModOff macro
(2)  591/   7542E :                     	if SonicDriverVer>=3
(2)  592/   7542E :                     		dc.b	$FA
(2)  593/   7542E :                     	else
(2)  594/   7542E :                     		dc.b	$F4
(2)  595/   7542E :                     	endif
(2)  596/   7542E :                     	endm
(2)  597/   7542E :                     
(2)  598/   7542E :                     ; F5xx - PSG voice to xx
(2)  599/   7542E :                     smpsPSGvoice macro voice
(2)  600/   7542E :                     	dc.b	$F5,voice
(2)  601/   7542E :                     	endm
(2)  602/   7542E :                     
(2)  603/   7542E :                     ; F6xxxx - Jump to xxxx
(2)  604/   7542E :                     smpsJump macro loc
(2)  605/   7542E :                     	dc.b	$F6
(2)  606/   7542E :                     	if SonicDriverVer<>1
(2)  607/   7542E :                     		dc.w	z80_ptr(loc)
(2)  608/   7542E :                     	else
(2)  609/   7542E :                     		dc.w	loc-*-1
(2)  610/   7542E :                     	endif
(2)  611/   7542E :                     	endm
(2)  612/   7542E :                     
(2)  613/   7542E :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   7542E :                     smpsLoop macro index,loops,loc
(2)  615/   7542E :                     	dc.b	$F7
(2)  616/   7542E :                     	dc.b	index,loops
(2)  617/   7542E :                     	if SonicDriverVer<>1
(2)  618/   7542E :                     		dc.w	z80_ptr(loc)
(2)  619/   7542E :                     	else
(2)  620/   7542E :                     		dc.w	loc-*-1
(2)  621/   7542E :                     	endif
(2)  622/   7542E :                     	endm
(2)  623/   7542E :                     
(2)  624/   7542E :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   7542E :                     smpsCall macro loc
(2)  626/   7542E :                     	dc.b	$F8
(2)  627/   7542E :                     	if SonicDriverVer<>1
(2)  628/   7542E :                     		dc.w	z80_ptr(loc)
(2)  629/   7542E :                     	else
(2)  630/   7542E :                     		dc.w	loc-*-1
(2)  631/   7542E :                     	endif
(2)  632/   7542E :                     	endm
