(1) 1774/   735D2 :                     ; ===========================================================================
(1) 1775/   735D2 :                     ; ---------------------------------------------------------------------------
(1) 1776/   735D2 :                     ; FM Note Values: b-0 to a#8
(1) 1777/   735D2 :                     ;
(1) 1778/   735D2 :                     ; Each row is an octave, starting with B and ending with A-sharp/B-flat.
(1) 1779/   735D2 :                     ; Notably, this differs from the PSG frequency table, which starts with C and
(1) 1780/   735D2 :                     ; ends with B. This is caused by 'FMSetFreq' subtracting $80 from the note
(1) 1781/   735D2 :                     ; instead of $81, meaning that the first frequency in the table ironically
(1) 1782/   735D2 :                     ; corresponds to the 'rest' note. The only way to use this frequency in a
(1) 1783/   735D2 :                     ; real note is to transpose the channel to a lower semitone.
(1) 1784/   735D2 :                     ;
(1) 1785/   735D2 :                     ; Rather than use a complete lookup table, other SMPS drivers such as
(1) 1786/   735D2 :                     ; Sonic 3's compute the octave, and only store a single octave's worth of
(1) 1787/   735D2 :                     ; notes in the table.
(1) 1788/   735D2 :                     ;
(1) 1789/   735D2 :                     ; Invalid transposition values will cause this table to be overflowed,
(1) 1790/   735D2 :                     ; resulting in garbage data being used as frequency values. In drivers that
(1) 1791/   735D2 :                     ; compute the octave instead, invalid transposition values merely cause the
(1) 1792/   735D2 :                     ; notes to wrap-around (the note below the lowest note will be the highest
(1) 1793/   735D2 :                     ; note). It's important to keep this in mind when porting buggy songs.
(1) 1794/   735D2 :                     ; ---------------------------------------------------------------------------
(1) 1795/   735D2 :                     MakeFMFrequency function frequency,roundFloatToInteger(frequency*1024*1024*2/FM_Sample_Rate)
(1) 1796/   735D2 :                     MakeFMFrequenciesOctave macro octave
(1) 1797/   735D2 :                     		; Frequencies for the base octave. The first frequency is B, the last frequency is B-flat.
(1) 1798/   735D2 :                     		irp op, 15.39, 16.35, 17.34, 18.36, 19.45, 20.64, 21.84, 23.13, 24.51, 25.98, 27.53, 29.15
(1) 1799/   735D2 :                     			dc.w MakeFMFrequency(op)+octave*$800
(1) 1800/   735D2 :                     		endm
(1) 1801/   735D2 :                     	endm
