(2)  147/      92 : E6 0F               	and	0Fh			; 7	; Want only lower nibble now
(2)  148/      94 : C6 22               	add	a,zDACDecodeTbl&0FFh	; 7	; Add in low byte of offset into decode table
(2)  149/      96 : 6F                  	ld	l,a			; 4	; hl = pointer to nibble entry in JMan2050 table
(2)  150/      97 : 7E                  	ld	a,(hl)			; 7	; a = JMan2050 entry for current nibble
(2)  151/      98 :                     	; After the following exx, we have:
(2)  152/      98 :                     	; bc' = size of sample, de' = location of sample, hl' = pointer to nibble entry in JMan2050 table,
(2)  153/      98 :                     	; c = pitch of sample, d = PCM accumulator,
(2)  154/      98 :                     	; e = command to select DAC output register, hl = pointer to DAC status
(2)  155/      98 : D9                  	exx				; 4
(2)  156/      99 : 82                  	add	a,d			; 4	; Add accumulator value...
(2)  157/      9A : 57                  	ld	d,a			; 4	; ... then store value back into accumulator
(2)  158/      9B : 75                  	ld	(hl),l			; 7	; Set flag to not accept driver input (l = FFh)
(2)  159/      9C : DD 73 00            	ld	(ix+0),e		; 19	; Select DAC output register
(2)  160/      9F : DD 72 01            	ld	(ix+1),d		; 19	; Send current data
(2)  161/      A2 : 74                  	ld	(hl),h			; 7	; Set flag to accept driver input (h = 1Fh)
(2)  162/      A3 :                     
(2)  163/      A3 : 41                  	ld	b,c			; 4	; b = sample pitch
(2)  164/      A4 : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  165/      A6 :                     
(2)  166/      A6 :                     	; After the following exx, we have:
(2)  167/      A6 :                     	; bc = size of sample, de = location of sample, hl = pointer to nibble entry in JMan2050 table,
(2)  168/      A6 :                     	; c' = pitch of sample, d' = PCM accumulator,
(2)  169/      A6 :                     	; e' = command to select DAC output register, hl' = pointer to DAC status
(2)  170/      A6 : D9                  	exx				; 4
(2)  171/      A7 : 3A FF 1F            	ld	a,(zDAC_Sample)		; 13	; a = sample we're playing (minus 81h)
(2)  172/      AA : CB 7F               	bit	7,a			; 8	; Test bit 7 of register a
(2)  173/      AC : C2 32 00            	jp	nz,zCheckForSamples	; 10	; If it is set, we need to get a new sample
(2)  174/      AF :                     
(2)  175/      AF : 13                  	inc	de			; 6	; Point to next byte of DAC sample
(2)  176/      B0 : 0B                  	dec	bc			; 6	; Decrement remaining bytes on DAC sample
(2)  177/      B1 : 79                  	ld	a,c			; 4	; a = low byte of remainig bytes
(2)  178/      B2 : B0                  	or	b			; 4	; Are there any bytes left?
(2)  179/      B3 : C2 77 00            	jp	nz,zPlayPCMLoop		; 10	; If yes, keep playing sample
(2)  180/      B6 :                     					; 301 in total
(2)  181/      B6 : C3 32 00            	jp	zCheckForSamples		; Sample is done; wait for new samples
(2)  182/      B9 :                     ;
(2)  183/      B9 :                     ; Subroutine - Play_SegaPCM
(2)  184/      B9 :                     ;
(2)  185/      B9 :                     ; This subroutine plays the "SEGA" sound.
(2)  186/      B9 :                     ;
(2)  187/      B9 :                     zPlay_SegaPCM:
(2)  188/      B9 : 11 00 80            	ld	de,zmake68kPtr(SegaPCM)		; de = bank-relative location of the SEGA sound
(2)  189/      BC : 21 78 69            	ld	hl,SegaPCM.size			; hl = size of the SEGA sound
(2)  190/      BF : 0E 2A               	ld	c,2Ah				; c = Command to select DAC output register
(2)  191/      C1 :                     
(2)  192/      C1 :                     zPlaySEGAPCMLoop:
(2)  193/      C1 : 1A                  	ld	a,(de)			; 7	; a = next byte from SEGA PCM
(2)  194/      C2 : DD 71 00            	ld	(ix+0),c		; 19	; Select DAC output register
(2)  195/      C5 : DD 77 01            	ld	(ix+1),a		; 19	; Send current data
(2)  196/      C8 :                     
(2)  197/      C8 : 06 0B               	ld	b,pcmLoopCounter(16000)	; 7	; b = pitch of the SEGA sample
(2)  198/      CA : 10 FE               	djnz	$			; 8	; Pitch loop
(2)  199/      CC :                     
(2)  200/      CC : 13                  	inc	de			; 6	; Point to next byte of DAC sample
(2)  201/      CD : 2B                  	dec	hl			; 6	; Decrement remaining bytes on DAC sample
(2)  202/      CE : 7D                  	ld	a,l			; 4	; a = low byte of remainig bytes
(2)  203/      CF : B4                  	or	h			; 4	; Are there any bytes left?
(2)  204/      D0 : C2 C1 00            	jp	nz,zPlaySEGAPCMLoop	; 10	; If yes, keep playing sample
(2)  205/      D3 :                     					; 90 in total
(2)  206/      D3 : C3 32 00            	jp	zCheckForSamples		; SEGA sound is done; wait for new samples
(2)  207/      D6 :                     
(2)  208/      D6 :                     zPCMMetadata macro label
(2)  209/      D6 :                     	dw	label					; Start
(2)  210/      D6 :                     	dw	label.size				; Length
(2)  211/      D6 :                     	dw	dpcmLoopCounter(label.sample_rate)	; Pitch
(2)  212/      D6 :                     	dw	0					; Padding
(2)  213/      D6 :                         endm
(2)  214/      D6 :                     
(2)  215/      D6 :                     ; DPCM metadata
(2)  216/      D6 :                     zPCM_Table:
(2)  217/      D6 : (MACRO)              	zPCMMetadata zDAC_Kick
(2)  217/      D6 : EE 00                       dw      zDAC_Kick                                   ; Start
(2)  217/      D8 : 52 03                       dw      zDAC_Kick.size                              ; Length
(2)  217/      DA : 17 00                       dw      dpcmLoopCounter(zDAC_Kick.sample_rate)      ; Pitch
(2)  217/      DC : 00 00                       dw      0                                       ; Padding
(2)  218/      DE : (MACRO)              	zPCMMetadata zDAC_Snare
(2)  218/      DE : 40 04                       dw      zDAC_Snare                                   ; Start
(2)  218/      E0 : 70 07                       dw      zDAC_Snare.size                              ; Length
(2)  218/      E2 : 01 00                       dw      dpcmLoopCounter(zDAC_Snare.sample_rate)      ; Pitch
(2)  218/      E4 : 00 00                       dw      0                                       ; Padding
(2)  219/      E6 : =0EAH                zTimpani_Pitch = $+4
(2)  220/      E6 : (MACRO)              	zPCMMetadata zDAC_Timpani
(2)  220/      E6 : B0 0B                       dw      zDAC_Timpani                                   ; Start
(2)  220/      E8 : 16 10                       dw      zDAC_Timpani.size                              ; Length
(2)  220/      EA : 1B 00                       dw      dpcmLoopCounter(zDAC_Timpani.sample_rate)      ; Pitch
(2)  220/      EC : 00 00                       dw      0                                       ; Padding
(2)  221/      EE :                     
(2)  222/      EE :                     ; DPCM data
(2)  223/      EE :                     zDAC_Kick:	include "sound/dac/dpcm/generated/kick.inc"
(3)    1/      EE : =203AH               .sample_rate = 8250
(3)    2/      EE : =352H                .size = 850
(3)    3/      EE :                     	binclude "sound/dac/dpcm/generated/kick.dpcm"
(3)    4/     440 :                     
(2)  224/     440 :                     zDAC_Snare:	include "sound/dac/dpcm/generated/snare.inc"
(3)    1/     440 : =5DC0H               .sample_rate = 24000
(3)    2/     440 : =770H                .size = 1904
(3)    3/     440 :                     	binclude "sound/dac/dpcm/generated/snare.dpcm"
(3)    4/     BB0 :                     
(2)  225/     BB0 :                     zDAC_Timpani:	include "sound/dac/dpcm/generated/timpani.inc"
(3)    1/     BB0 : =1CCFH               .sample_rate = 7375
(3)    2/     BB0 : =1016H               .size = 4118
(3)    3/     BB0 :                     	binclude "sound/dac/dpcm/generated/timpani.dpcm"
(3)    4/    1BC6 :                     
(2)  226/    1BC6 :                     
Uncompressed driver size: 1BC6h bytes.
(2)  231/    1BC6 :                     			message "Uncompressed driver size: \{$}h bytes."
(2)  234/    1BC6 :                     
(2)  235/    1BC6 : ALL                  	restore
(2)  236/    1BC6 :                     	padding off
