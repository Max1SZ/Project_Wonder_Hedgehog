(2)  634/   7542E :                     ; Alter Volume
(2)  635/   7542E :                     smpsFMAlterVol macro val1,val2
(2)  636/   7542E :                     	if ("val2"<>"")
(2)  637/   7542E :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   7542E :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   7542E :                     		if (SonicDriverVer>=3)
(2)  640/   7542E :                     			dc.b	$E5,val1,val2
(2)  641/   7542E :                     		else
(2)  642/   7542E :                     			dc.b	$E6,val2
(2)  643/   7542E :                     		endif
(2)  644/   7542E :                     	else
(2)  645/   7542E :                     		; Normal, sane command.
(2)  646/   7542E :                     		dc.b	$E6,val1
(2)  647/   7542E :                     	endif
(2)  648/   7542E :                     	endm
