    6103/   154D4 :                     
    6104/   154D4 :                     ; ---------------------------------------------------------------------------
    6105/   154D4 :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
    6106/   154D4 :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
    6107/   154D4 :                     ; Pointers to said raw data are dummied out.
    6108/   154D4 :                     ; Curiously, an example of the original 'raw' data that this was intended
    6109/   154D4 :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
    6110/   154D4 :                     ; ---------------------------------------------------------------------------
    6111/   154D4 :                     
    6112/   154D4 : =$63A0A              RawColBlocks		equ CollArray1
    6113/   154D4 : =$63A0A              ConvRowColBlocks	equ CollArray1
    6114/   154D4 :                     
    6115/   154D4 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    6116/   154D4 :                     
    6117/   154D4 :                     
    6118/   154D4 :                     ConvertCollisionArray:
    6119/   154D4 : 4E75                		rts
    6120/   154D6 :                     ; ---------------------------------------------------------------------------
    6121/   154D6 :                     		; The raw format stores the collision data column by column for the normal collision array.
    6122/   154D6 :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
    6123/   154D6 : 43F9 0006 3A0A      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
