    6140/   154F4 : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
    6141/   154F6 : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
    6142/   154F8 : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
    6143/   154FC :                     
    6144/   154FC : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
    6145/   154FE : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
    6146/   15502 : 5345                		subq.w	#1,d5			; Get next bit in the row
    6147/   15504 : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
    6148/   15508 :                     
