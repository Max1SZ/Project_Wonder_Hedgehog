(2)  238/   7542E :                     
(1) 2638/   7542E :                     
(1) 2639/   7542E :                     ; ---------------------------------------------------------------------------
(1) 2640/   7542E :                     ; SMPS2ASM - A collection of macros that make SMPS's bytecode human-readable.
(1) 2641/   7542E :                     ; ---------------------------------------------------------------------------
(1) 2642/   7542E : =$1                  FixMusicAndSFXDataBugs = FixBugs
(1) 2643/   7542E : =$1                  SonicDriverVer = 1 ; Tell SMPS2ASM that we're using Sonic 1's driver.
(1) 2644/   7542E :                     		include "sound/_smps2asm_inc.asm"
(2)    1/   7542E :                     ; ===========================================================================
