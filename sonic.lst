(2)  825/   7542E :                     	eval vcCF1,op1
(2)  826/   7542E :                     	eval vcCF2,op2
(2)  827/   7542E :                     	eval vcCF3,op3
(2)  828/   7542E :                     	eval vcCF4,op4
(2)  829/   7542E :                     	endm
(2)  830/   7542E :                     
(2)  831/   7542E :                     ; Voices - Rate Scale
(2)  832/   7542E :                     smpsVcRateScale macro op1,op2,op3,op4
(2)  833/   7542E :                     	eval vcRS1,op1
(2)  834/   7542E :                     	eval vcRS2,op2
(2)  835/   7542E :                     	eval vcRS3,op3
(2)  836/   7542E :                     	eval vcRS4,op4
(2)  837/   7542E :                     	endm
(2)  838/   7542E :                     
(2)  839/   7542E :                     ; Voices - Attack Rate
(2)  840/   7542E :                     smpsVcAttackRate macro op1,op2,op3,op4
(2)  841/   7542E :                     	eval vcAR1,op1
(2)  842/   7542E :                     	eval vcAR2,op2
(2)  843/   7542E :                     	eval vcAR3,op3
(2)  844/   7542E :                     	eval vcAR4,op4
(2)  845/   7542E :                     	endm
(2)  846/   7542E :                     
(2)  847/   7542E :                     ; Voices - Amplitude Modulation
(2)  848/   7542E :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   7542E :                     ; were the Amplitude Modulation.
(2)  850/   7542E :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   7542E :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   7542E :                     	if SourceSMPS2ASM==0
(2)  853/   7542E :                     		eval vcAM1,op1<<5
(2)  854/   7542E :                     		eval vcAM2,op2<<5
(2)  855/   7542E :                     		eval vcAM3,op3<<5
(2)  856/   7542E :                     		eval vcAM4,op4<<5
(2)  857/   7542E :                     	else
(2)  858/   7542E :                     		eval vcAM1,op1<<7
(2)  859/   7542E :                     		eval vcAM2,op2<<7
(2)  860/   7542E :                     		eval vcAM3,op3<<7
(2)  861/   7542E :                     		eval vcAM4,op4<<7
(2)  862/   7542E :                     	endif
(2)  863/   7542E :                     	endm
(2)  864/   7542E :                     
(2)  865/   7542E :                     ; Voices - First Decay Rate
(2)  866/   7542E :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   7542E :                     	eval vcD1R1,op1
(2)  868/   7542E :                     	eval vcD1R2,op2
(2)  869/   7542E :                     	eval vcD1R3,op3
(2)  870/   7542E :                     	eval vcD1R4,op4
(2)  871/   7542E :                     	endm
(2)  872/   7542E :                     
(2)  873/   7542E :                     ; Voices - Second Decay Rate
(2)  874/   7542E :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   7542E :                     	eval vcD2R1,op1
(2)  876/   7542E :                     	eval vcD2R2,op2
(2)  877/   7542E :                     	eval vcD2R3,op3
(2)  878/   7542E :                     	eval vcD2R4,op4
(2)  879/   7542E :                     	endm
(2)  880/   7542E :                     
(2)  881/   7542E :                     ; Voices - Decay Level
(2)  882/   7542E :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   7542E :                     	eval vcDL1,op1
(2)  884/   7542E :                     	eval vcDL2,op2
(2)  885/   7542E :                     	eval vcDL3,op3
(2)  886/   7542E :                     	eval vcDL4,op4
(2)  887/   7542E :                     	endm
(2)  888/   7542E :                     
(2)  889/   7542E :                     ; Voices - Release Rate
(2)  890/   7542E :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   7542E :                     	eval vcRR1,op1
(2)  892/   7542E :                     	eval vcRR2,op2
(2)  893/   7542E :                     	eval vcRR3,op3
(2)  894/   7542E :                     	eval vcRR4,op4
(2)  895/   7542E :                     	endm
(2)  896/   7542E :                     
(2)  897/   7542E :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   7542E :                     
(2)  899/   7542E :                     smpsDcb macro
(2)  900/   7542E :                     		if smpsNotZ80(MOMCPU)
(2)  901/   7542E :                     			dc.b ALLARGS
(2)  902/   7542E :                     		else
(2)  903/   7542E :                     			db ALLARGS
(2)  904/   7542E :                     		endif
(2)  905/   7542E :                     	endm
(2)  906/   7542E :                     
(2)  907/   7542E :                     ; Voices - Total Level
(2)  908/   7542E :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   7542E :                     ; but later versions leave it up to the user.
(2)  910/   7542E :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   7542E :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   7542E :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   7542E :                     ; SMPS Z80 does the opposite.
(2)  914/   7542E :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   7542E :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   7542E :                     ; what we do, so we just print a warning.
(2)  917/   7542E :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   7542E :                     	eval vcTL1,op1
(2)  919/   7542E :                     	eval vcTL2,op2
(2)  920/   7542E :                     	eval vcTL3,op3
(2)  921/   7542E :                     	eval vcTL4,op4
(2)  922/   7542E :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   7542E :                     ;   0     1     2     3     4     5     6     7
(2)  924/   7542E :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   7542E :                     	if SourceSMPS2ASM==0
(2)  926/   7542E :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   7542E :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   7542E :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   7542E :                     		eval vcTLMask1,128
(2)  930/   7542E :                     	else
(2)  931/   7542E :                     		eval vcTLMask4,0
(2)  932/   7542E :                     		eval vcTLMask3,0
(2)  933/   7542E :                     		eval vcTLMask2,0
(2)  934/   7542E :                     		eval vcTLMask1,0
(2)  935/   7542E :                     	endif
(2)  936/   7542E :                     
(2)  937/   7542E :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   7542E :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   7542E :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   7542E :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   7542E :                     		eval vcTLMask1,128
(2)  942/   7542E :                     		eval vcTL1,vcTL1&127
(2)  943/   7542E :                     		eval vcTL2,vcTL2&127
(2)  944/   7542E :                     		eval vcTL3,vcTL3&127
(2)  945/   7542E :                     		eval vcTL4,vcTL4&127
(2)  946/   7542E :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   7542E :                     		if MOMPASS=1
(2)  948/   7542E :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   7542E :                     		endif
(2)  950/   7542E :                     	endif
(2)  951/   7542E :                     
(2)  952/   7542E :                     	if SonicDriverVer==2
(2)  953/   7542E :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   7542E :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   7542E :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   7542E :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   7542E :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   7542E :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   7542E :                     	else
(2)  960/   7542E :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   7542E :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   7542E :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   7542E :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   7542E :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   7542E :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   7542E :                     	endif
(2)  967/   7542E :                     	endm
