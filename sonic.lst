(2)  817/   7542E :                     	eval vcDT1,op1
(2)  818/   7542E :                     	eval vcDT2,op2
(2)  819/   7542E :                     	eval vcDT3,op3
(2)  820/   7542E :                     	eval vcDT4,op4
(2)  821/   7542E :                     	endm
(2)  822/   7542E :                     
(2)  823/   7542E :                     ; Voices - Coarse-Frequency
