(1) 2040/   7381E :                     ; ---------------------------------------------------------------------------
(1) 2041/   7381E :                     ; PSG Note Values: c-1 to a-6
(1) 2042/   7381E :                     ;
(1) 2043/   7381E :                     ; Each row is an octave, starting with C and ending with B. Sonic 3's driver
(1) 2044/   7381E :                     ; adds another octave at the start, as well as two more notes and the end to
(1) 2045/   7381E :                     ; complete the last octave. Notably, a-6 is changed from 223721.56Hz to
(1) 2046/   7381E :                     ; 6991.28Hz. These changes need to be applied here in order for ports of
(1) 2047/   7381E :                     ; songs from Sonic 3 and later to sound correct.
(1) 2048/   7381E :                     ;
(1) 2049/   7381E :                     ; Here is what Sonic 3's version of this table looks like:
(1) 2050/   7381E :                     ;		MakePSGFrequencies  109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    110.20,    116.76,    123.73
(1) 2051/   7381E :                     ;		MakePSGFrequencies  130.98,    138.78,    146.99,    155.79,    165.22,    174.78,    185.19,    196.24,    207.91,    220.63,    233.52,    247.47
(1) 2052/   7381E :                     ;		MakePSGFrequencies  261.96,    277.56,    293.59,    311.58,    329.97,    349.56,    370.39,    392.49,    415.83,    440.39,    468.03,    494.95
(1) 2053/   7381E :                     ;		MakePSGFrequencies  522.71,    556.51,    588.73,    621.44,    661.89,    699.12,    740.79,    782.24,    828.59,    880.79,    932.17,    989.91
(1) 2054/   7381E :                     ;		MakePSGFrequencies 1045.42,   1107.52,   1177.47,   1242.89,   1316.00,   1398.25,   1491.47,   1575.50,   1669.55,   1747.82,   1864.34,   1962.46
(1) 2055/   7381E :                     ;		MakePSGFrequencies 2071.49,   2193.34,   2330.42,   2485.78,   2601.40,   2796.51,   2943.69,   3107.23,   3290.01,   3495.64,   3608.40,   3857.25
(1) 2056/   7381E :                     ;		MakePSGFrequencies 4142.98,   4302.32,   4660.85,   4863.50,   5084.56,   5326.69,   5887.39,   6214.47,   6580.02,   6991.28, 223721.56, 223721.56
