    6128/   154E6 :                     .blockLoop:
    6129/   154E6 : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
    6130/   154E8 :                     
    6131/   154E8 : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
    6132/   154EC :                     
