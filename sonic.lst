(2)  801/   7542E :                     vcUnusedBits eval val
(2)  802/   7542E :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   7542E :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   7542E :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   7542E :                     		eval vcD1R3Unk,d1r3<<5
(2)  806/   7542E :                     		eval vcD1R4Unk,d1r4<<5
(2)  807/   7542E :                     	else
(2)  808/   7542E :                     		eval vcD1R1Unk,0
(2)  809/   7542E :                     		eval vcD1R2Unk,0
(2)  810/   7542E :                     		eval vcD1R3Unk,0
(2)  811/   7542E :                     		eval vcD1R4Unk,0
